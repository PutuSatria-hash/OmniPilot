# ==============================================================================
# OmniPilot Hub - Personal AI Automation & Remote Command Center Configuration
# ==============================================================================

# --- Server & Security ---
HOST=0.0.0.0
PORT=8787
# Token rahasia untuk mengakses API, Web PWA, dan Phone Heartbeat
API_AUTH_TOKEN=CHANGE_ME_TO_A_STRONG_SECRET_TOKEN
ALLOWED_ORIGINS=*

# --- AI Engine: Multi-Provider Free Waterfall (Anti-Kehabisan Token) ---
# Urutan otomatis: Gemini -> Groq -> Cerebras -> OpenRouter (:free) -> Mistral -> Ollama Lokal
# 1. Google AI Studio (Gratis): https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-4-hydrogen,gemma-4-26b-a4b-it,gemma-4-31b-it

# 2. Groq Free API (Gratis ~1.000 req/hari, sangat cepat + tool calling): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,qwen/qwen3-32b

# 3. Cerebras Free API (Gratis, kuota harian sangat besar): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODELS=llama3.1-8b,gpt-oss-120b

# 4. OpenRouter Free Models (banyak model :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,qwen/qwen3-next-80b-a3b-instruct:free

# 5. Mistral AI Free Tier: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODELS=mistral-small-latest

# 6. Ollama (Lokal http://127.0.0.1:11434/v1 tanpa API key, atau Cloud https://ollama.com/v1 dengan OLLAMA_API_KEY dari https://ollama.com/settings/keys)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --- Remote Chat: Telegram Bot (Opsi B / Hybrid) ---
# Buat bot di @BotFather, cek ID Anda di @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Smart Escalation Alarm & Phone Activity Detection ---
# Stage 1 -> Stage 2 (warning) -> Stage 3 (CRITICAL ALARM bypass silent)
ALARM_DEFAULT_TIMEOUT_MINUTES=5
PHONE_INACTIVE_THRESHOLD_MINUTES=10
PC_FALLBACK_SIREN_ENABLED=true

# [Alarm Opsi A - Gratis & Full Control Android] ntfy.sh + MacroDroid/Tasker
# Buat nama topic rahasia yang unik dan acak!
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
MACRODROID_WEBHOOK_URL=

# [Alarm Opsi B - Lintas Android & iOS Critical Alerts] Pushover Priority 2
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- Daily Schedule & Google Calendar ---
MORNING_BRIEFING_TIME=06:30
TIMEZONE=Asia/Makassar
# Opsional: Link Secret iCal (.ics) dari Google Calendar Settings agar jadwal otomatis sinkron tanpa OAuth rumit
GOOGLE_CALENDAR_ICS_URL=

# --- Gmail & Google OAuth (Opsional jika tidak memakai Plugin Antigravity) ---
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# --- LMS Automation (Playwright Persistent Profile) ---
LMS_BASE_URL=
LMS_PLATFORM=moodle
LMS_HEADLESS=false

# --- WhatsApp Safe Bridge ---
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3005
WHATSAPP_ENABLED=false

# --- Remote Desktop Quick Links & PC Lab Kampus (Zero-Install) ---
RUSTDESK_PC_ID=
SUNSHINE_HOST_IP=
CAMPUS_TUNNEL_URL=
REMOTE_INPUT_ENABLED=true
# Kosongkan agar otomatis memakai folder tempat OmniPilot disimpan
ANTIGRAVITY_WORKSPACE_DEFAULT=
